{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "rare-ui-pro",
  "homepage": "https://rareui.com",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper for merging Tailwind classes.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "light-beam-card",
      "type": "registry:ui",
      "title": "Light Beam Card",
      "description": "A card lit by a warm beam of light that pours in from one corner.",
      "dependencies": [
        "motion"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "components/pro/light-beam-card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "folder",
      "type": "registry:ui",
      "title": "Folder",
      "description": "A soft folder with a few cards peeking out of the top.",
      "dependencies": [
        "motion"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "components/pro/folder.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
